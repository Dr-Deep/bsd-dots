* {
    border: none;
    border-radius: 4px;
    /* Droid Sans Mono:style=Regular:pixelsize=10;2 */
    font-family: Droid Sans Mono;
    font-size: 13px;
    min-height: 0;
}

window.bar1#waybar {
     background: rgba(0, 0, 0, 0.8);
    color: white;
    border-bottom: 1px solid #444444;
    padding: 5px;

    margin-right: 2px;
    margin-left: 2px;
} 

window.bar2#waybar {
     background: rgba(0, 0, 0, 0.8);
    color: white;
    border-top: 1px solid #444444;
    padding: 5px;

    margin-right: 2px;
    margin-left: 2px;
} 

